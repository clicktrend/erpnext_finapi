   "default": "2",
   "fieldname": "sync_overlap_days",
   "fieldtype": "Int",
   "label": "Sync Overlap (days)",
   "description": "Safety overlap re-read on every sync. Duplicates are filtered by finAPI transaction id."
  },
  {
   "default": "14",
   "fieldname": "consent_warning_days",
   "fieldtype": "Int",
   "label": "Consent Warning (days)",
