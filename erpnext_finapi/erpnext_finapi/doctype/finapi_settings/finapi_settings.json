   "label": "Transaction Sync"
  },
  {
   "default": "1",
   "fieldname": "auto_sync",
   "fieldtype": "Check",
   "label": "Enable Scheduled Sync",
   "description": "Master switch. The scheduler runs 4×/day — PSD2 caps unattended bank updates at 4 per 24h."
  },
  {
   "default": "90",
   "fieldname": "initial_sync_days",
   "fieldtype": "Int",
   "label": "Initial Sync (days)",
   "description": "How far back the very first sync of a connection reads."
