   "fieldname": "section_environment",
   "fieldtype": "Section Break",
   "label": "Environment"
  },
  {
   "default": "Sandbox",
   "fieldname": "environment",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Default Environment",
   "options": "Sandbox\nLive",
   "reqd": 1,
   "description": "Preselected for a new finAPI User and used by Test Connection. It does not restrict anything: every finAPI User carries its own environment, and the credentials of that environment are used — so Sandbox and Live can be set up side by side."
